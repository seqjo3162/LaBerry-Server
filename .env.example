# ===========================
# LaBerry Server - Security Configuration
# ===========================
# Copy this file to .env and configure for your deployment

# ============================================
# 🔑 CORE SECURITY
# ============================================

# Secret key for JWT signing (MINIMUM 32 bytes, RECOMMENDED 64+ random alphanumeric)
# Generate: openssl rand -base64 32
SECRET_KEY=your_secret_key_here_at_least_64_chars_minimum

# JWT Issuer
JWT_ISSUER=laberry

# ============================================
# 🔐 HTTPS/TLS (for native TLS mode)
# ============================================

# Optional: Use if NOT behind reverse proxy
# LB_TLS_CERT_PATH=/path/to/certificate.pem
# LB_TLS_KEY_PATH=/path/to/private.key

# Domain for E2EE and security headers
LB_DOMAIN=laberry.ru

# ============================================
# 📡 SERVER BINDING
# ============================================

# HTTP binding (use 127.0.0.1 if behind reverse proxy, 0.0.0.0 for native TLS)
LB_HOST=127.0.0.1
LB_PORT=5000

# ============================================
# 🗄️ DATABASE
# ============================================

DATABASE_URL=sqlite:./laberry.db

# ============================================
# 🔐 AUTHENTICATION
# ============================================

# Email verification (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@laberry.ru
# SMTP_PASSWORD=your_password

# ============================================
# 🛡️ ADMIN PANEL (local-only)
# ============================================

# Enable admin panel (default: false)
LB_ENABLE_ADMIN_PANEL=true

# Admin panel binding (ALWAYS loopback for security!)
LB_ADMIN_HOST=127.0.0.1
LB_ADMIN_PORT=5002

# Admin password (one must be set: LB_ADMIN_PASSWORD or LB_ADMIN_PASSWORD_HASH)
LB_ADMIN_PASSWORD=your_secure_admin_password_here

# Or use pre-hashed password (Argon2):
# LB_ADMIN_PASSWORD_HASH=<argon2_hash>

# ============================================
# 📞 VOICE/VIDEO (TURN Server)
# ============================================

# STUN servers (free public ones for fallback)
LB_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server credentials (optional, for better NAT traversal)
# LB_TURN_URLS=turn:turn.laberry.ru:3478
# LB_TURN_SECRET=your_turn_secret_here_min_32_bytes
# LB_TURN_TTL_SEC=3600

# Or static credentials:
# LB_TURN_USERNAME=turnuser
# LB_TURN_PASSWORD=turnpassword

# ============================================
# 🤖 AI (Optional)
# ============================================

# Enable AI features
# LB_AI_ENABLED=false

# AI user name
# LB_AI_USER_NAME=Gemka III

# ============================================
# 🔄 SECURITY HEADERS
# ====================================

# Custom CSP (Content Security Policy)
# LB_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; ...

# CORS allowed origins (comma-separated, or "*" for allow all)
# CORS_ALLOWED_ORIGINS=https://laberry.ru

# ============================================
# 🔔 NOTIFICATIONS
# ============================================

# Web Push notifications (optional)
# PUSH_PUBLIC_KEY=<public_key>
# PUSH_PRIVATE_KEY=<private_key>

# ============================================
# � CORS & CSRF SECURITY (PHASE 1 FIX)
# ============================================

# Allowed CORS origins (comma-separated list, REQUIRED for production!)
# ⚠️  NEVER use "*" in production! Specify exact origins:
# Examples:
# CORS_ALLOWED_ORIGINS=https://laberry.ru,https://app.laberry.ru,https://web.laberry.ru
# Or for development:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ============================================
# 📊 LOGGING & DEBUG
# ============================================

# Log level
RUST_LOG=info

# Enable detailed request logging (development only!)
# LB_DEBUG_REQUESTS=false

# Enable WebSocket debug logging
# LB_DEBUG_WS=0

# ============================================
# ⏱️ TOKEN TTL (seconds)
# ============================================

# Access token expiration (default: 1 hour)
# ACCESS_TOKEN_TTL_SECS=3600

# Refresh token expiration (default: 30 days)
# REFRESH_TOKEN_TTL_SECS=2592000

# File download token expiration (default: 60 seconds)
# FILE_DL_TTL_SECS=60

# ============================================
# 🚀 DEPLOYMENT & PERFORMANCE
# ============================================

# Environment: production, staging, development
# ENVIRONMENT=production

# Host guard enable/disable (RECOMMENDED: always enabled for security)
# LB_DISABLE_HOST_GUARD=false

# ============================================
# ⚠️ SECURITY NOTES (PHASE 1 IMPLEMENTED)
# ============================================

# ✅ SECURITY FIXES IN THIS VERSION:
# 1. 2FA Code TTL (5 minutes) + Attempt Limiting (3 attempts → 15min lockout)
# 2. CSRF Protection (X-CSRF-Token header required for state-changing operations)
# 3. File Download Authorization (user must be in chat containing file)
# 4. Persistent Rate Limiting (survives server restart)
# 5. Timing-Safe Authentication (prevents user enumeration)

# ⚠️ GENERAL SECURITY RECOMMENDATIONS:
# 1. NEVER commit .env with real secrets to version control
# 2. Use a secrets manager (Vault, AWS Secrets Manager) in production
# 3. Rotate SECRET_KEY every 90 days
# 4. Ensure TLS certificates are valid and not self-signed
# 5. Always use HTTPS in production (set LB_TLS_CERT_PATH and LB_TLS_KEY_PATH)
# 6. Set CORS_ALLOWED_ORIGINS to specific domains, never use "*"
# 7. Monitor audit_logs table for security events
# 5. Enable 2FA for all admin accounts
# 6. Use strong, unique admin password
# 7. Monitor logs for unusual activity
# 8. Keep Rust and dependencies updated
# 9. Run security audits regularly
# 10. Backup database daily with encryption

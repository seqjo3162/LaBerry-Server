# ============================================
# LaBerry-Server — шаблон .env (коммитится)
# Скопируйте в .env и подставьте реальные секреты.
# ============================================

# Учётные данные PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me_db

# Строка подключения для сервиса `web`.
# Хост/порт/БД должны совпадать со значениями POSTGRES_* выше.
DATABASE_URL=postgres://postgres:change_me@db:5432/messenger_db

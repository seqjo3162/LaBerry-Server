# ============================================
# LaBerry-Server Configuration Template
# ============================================
# Скопируйте этот файл в .env и заполните значения.
# НЕ коммитьте .env в git!
# ============================================

# ============================================
# JWT Configuration (КРИТИЧНО)
# ============================================
# SECRET_KEY: Минимум 32 байта для HMAC ключа
# JWT_SECRET: Минимум 32 байта для JWT подписи
# Сгенерируйте случайные значения:
#   openssl rand -hex 32
# Или используйте: cargo run admin generate-password-hash
SECRET_KEY=your-secret-key-here-minimum-32-bytes-long
JWT_SECRET=your-jwt-secret-here-minimum-32-bytes-long

# ============================================
# Admin Password (КРИТИЧНО)
# ============================================
# Сгенерируйте хеш пароля:
#   cargo run admin generate-password-hash
# Или:
#   LB_ADMIN_PASSWORD=your-plain-password (для тестирования)
LB_ADMIN_PASSWORD_HASH=
LB_ADMIN_PASSWORD=

# ============================================
# TURN/STUN Configuration
# ============================================
# TURN REST API secret (рекомендуется)
LB_TURN_SECRET=
# Альтернатива: static username/password
LB_TURN_USERNAME=
LB_TURN_PASSWORD=
LB_TURN_TTL_SEC=3600

# ============================================
# TLS Configuration (опционально)
# ============================================
# Если используете TLS, укажите пути к файлам:
LB_TLS_CERT_PATH=
LB_TLS_KEY_PATH=

# ============================================
# Feature Flags
# ============================================
LB_ENABLE_ADMIN_PANEL=false

# ============================================
# AI Configuration (опционально)
# ============================================
# LB_AI_API_KEY=
# LB_AI_BASE_URL=
# LB_AI_MODEL=

# ============================================
# Email Configuration (опционально)
# ============================================
# LB_EMAIL_SMTP_HOST=
# LB_EMAIL_SMTP_PORT=587
# LB_EMAIL_USERNAME=
# LB_EMAIL_PASSWORD=
# LB_EMAIL_FROM_ADDRESS=
# LB_EMAIL_FROM_NAME=

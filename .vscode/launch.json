{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against 0.0.0.0",
      "url": "http://0.0.0.0:5001",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "trace": true,
      "sourceMapPathOverrides": {
        "webpack:///./static/*": "${webRoot}/static/*"
      }
    }
  ]
}